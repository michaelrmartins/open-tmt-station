# ---------------------------------------------------------------
# Copy to .env and adjust:  cp .env.example .env
# ---------------------------------------------------------------

# Public port for the web page (nginx)
WEB_PORT=8080

# --- InfluxDB 1.x (InfluxQL) ---
# Inside Docker, "localhost" is the container itself. Use the server IP/hostname,
# or host.docker.internal (see extra_hosts in docker-compose.yml).
INFLUX_URL=http://192.168.1.10:8086
INFLUX_DB=telegraf
INFLUX_RP=
# Prefer a read-only user for the public API
INFLUX_USER=
INFLUX_PASSWORD=
# InfluxDB 2.x via the v1 compatibility API (DBRP mapping): set a read token instead of user/password
INFLUX_TOKEN=
INFLUX_TIMEOUT_MS=10000

# Measurement written by Telegraf's mqtt_consumer, and the Tasmota topic prefix of the station
INFLUX_MEASUREMENT=mqtt_consumer
DEVICE_TOPIC_PREFIX=tele/esp32_varanda/

# --- Station ---
STATION_NAME=Weather Station
STATION_LOCATION=
# DC input source: solar | psu
POWER_MODE=solar

# Live indicator: green while the last reading is newer than this (seconds).
# With deep sleep on, after this window it shows "Sleeping" (amber) until the next
# expected wake-up + DEEP_SLEEP_GRACE_SECONDS; after that it shows "Offline" (red).
LIVE_WINDOW_SECONDS=300
DEEP_SLEEP_GRACE_SECONDS=90

# Battery voltage scale (Grafana constants $BAT_EMPTY / $BAT_MAX)
BAT_EMPTY=3.0
BAT_MAX=4.135

# --- External weather: OpenWeather (shown in the banner at the top of the page) ---
# Free key: https://home.openweathermap.org/api_keys  (leave empty to hide the outside weather)
OPENWEATHER_API_KEY=
# Location: latitude/longitude (preferred) ...
OPENWEATHER_LAT=
OPENWEATHER_LON=
# ... or a city query, used only when LAT/LON are empty (e.g. Campinas,BR)
OPENWEATHER_CITY=
# Optional name shown on the page (defaults to the name returned by OpenWeather)
OPENWEATHER_LOCATION_NAME=
# Language of the condition text (en, pt_br, ...)
OPENWEATHER_LANG=en
# The backend calls OpenWeather on this schedule only (2 requests per refresh), never per visitor.
# Default 60 minutes, minimum 10.
OPENWEATHER_REFRESH_MINUTES=60

# --- API ---
# Comma-separated allowed origins, or * (the page itself is served on the same origin through nginx)
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
CACHE_SNAPSHOT_TTL_MS=15000
CACHE_HISTORY_TTL_MS=60000
# Number of reverse proxies in front of the API (nginx = 1)
TRUST_PROXY=1

# Serve synthetic data instead of querying InfluxDB (demo / frontend development)
MOCK_DATA=false
