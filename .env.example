# ---------------------------------------------------------------
# Copy to .env and adjust:  cp .env.example .env
# ---------------------------------------------------------------

# Public port for the web page (nginx)
WEB_PORT=8080

# --- InfluxDB 1.x (InfluxQL) ---
# Inside Docker, "localhost" is the container itself. Use the server IP/hostname,
# or host.docker.internal (see extra_hosts in docker-compose.yml).
INFLUX_URL=http://192.168.1.10:8086
INFLUX_DB=telegraf
INFLUX_RP=
# Prefer a read-only user for the public API
INFLUX_USER=
INFLUX_PASSWORD=
# InfluxDB 2.x via the v1 compatibility API (DBRP mapping): set a read token instead of user/password
INFLUX_TOKEN=
INFLUX_TIMEOUT_MS=10000

# Measurement written by Telegraf's mqtt_consumer, and the Tasmota topic prefix of the station
INFLUX_MEASUREMENT=mqtt_consumer
DEVICE_TOPIC_PREFIX=tele/esp32_varanda/

# --- Station ---
STATION_NAME=Weather Station
STATION_LOCATION=
# DC input source: solar | psu
POWER_MODE=solar

# Battery voltage scale (Grafana constants $BAT_EMPTY / $BAT_MAX)
BAT_EMPTY=3.0
BAT_MAX=4.135

# --- API ---
# Comma-separated allowed origins, or * (the page itself is served on the same origin through nginx)
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
CACHE_SNAPSHOT_TTL_MS=15000
CACHE_HISTORY_TTL_MS=60000
# Number of reverse proxies in front of the API (nginx = 1)
TRUST_PROXY=1

# Serve synthetic data instead of querying InfluxDB (demo / frontend development)
MOCK_DATA=false
